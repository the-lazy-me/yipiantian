#!/usr/bin/env python
"""Build the macos_desktop GDExtension (universal arm64 + x86_64)."""

import os

repo_root = Dir("../../").abspath
godot_cpp_path = os.environ.get(
    "GODOT_CPP_PATH", os.path.join(repo_root, ".local", "godot-cpp")
)
sconstruct_path = os.path.join(godot_cpp_path, "SConstruct")
if not os.path.isfile(sconstruct_path):
    raise SystemExit(
        "godot-cpp SConstruct not found at %s (set GODOT_CPP_PATH)" % sconstruct_path
    )

env = SConscript(sconstruct_path, {"api_version": "4.7"})

ext_env = env.Clone()
ext_env.Append(CPPPATH=[Dir("src")])
# Objective-C++ with ARC for the AppKit code.
ext_env.Append(CCFLAGS=["-fobjc-arc"])
ext_env.Append(LINKFLAGS=["-framework", "AppKit", "-framework", "CoreGraphics"])
ext_env["SHLIBPREFIX"] = ""
ext_env["SHLIBSUFFIX"] = ".dylib"

extension = ext_env.SharedLibrary("build/macos_desktop", ["src/macos_desktop.mm"])
Default(extension)
